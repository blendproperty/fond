# Confirm the actual Hostinger VPS routing values before deployment.
FOND_HOST=
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
# In-person payment remains available. Optional hosted Yoco checkout is below.
# Never use NEXT_PUBLIC_ for secrets.
# Where the account/order SQLite database lives inside the container.
# Must point at the mounted volume declared in compose.yaml.
FOND_DB_PATH=/app/data/fond.sqlite
# Optional bootstrap/fallback staff tablet code. Once the credential vault is
# ready, rotate the shared tablet code in super-admin Settings instead.
FOND_STAFF_CODE=
# One-time bootstrap admin code. Create a named super admin in Settings, then
# enroll 2FA. The shared code stops working after that enrollment.
FOND_ADMIN_CODE=

# One-time server bootstrap for the Settings credential vault. Generate a
# random 32-byte value as 64 hex characters, store it outside Git and back
# it up securely. Changing it without re-encrypting saved provider keys makes
# them unreadable. Provider keys themselves are entered in /admin Settings.
FOND_CREDENTIALS_KEY=
# Legacy Meta WhatsApp adapter only. For the purchased Twilio sender, enter
# the auth token, Account SID, sender and approved template SIDs in Settings.
FOND_WHATSAPP_TOKEN=
FOND_WHATSAPP_PHONE_NUMBER_ID=

# Legacy Yoco secret fallback. Use write-only Settings fields for new setup.
# Keep onlinePaymentsEnabled off until signed sandbox webhook verification.
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
FOND_PUBLIC_URL=https://fond.mid-point.co.za

# Set true ONLY on an isolated staging database for sandbox payments.
# Never enable on the restaurant production database. Live keys work without it.
FOND_ALLOW_TEST_PAYMENTS=false
