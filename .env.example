# Confirm the actual Hostinger VPS routing values before deployment.
FOND_HOST=
TRAEFIK_NETWORK=
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=
# Payment is handled in person at the venue (card machine or cash). No payment
# provider secrets are needed. Never use NEXT_PUBLIC_ for secrets.
# Where the account/order SQLite database lives inside the container.
# Must point at the mounted volume declared in compose.yaml.
FOND_DB_PATH=/app/data/fond.sqlite
# Shared access code for the facility staff tablet (/staff). Pick a short
# numeric or alphanumeric code known only to on-site staff.
FOND_STAFF_CODE=
# Separate, stricter access code for the admin/CRM panel (/admin), where
# menu items, prices, availability and specials are managed, and the full
# order history can be searched. Keep this different from FOND_STAFF_CODE
# and known only to whoever runs the business.
FOND_ADMIN_CODE=
# Optional: WhatsApp order-status notifications (order accepted/ready). Both
# must be set for messages to actually send — see src/lib/whatsapp.ts for
# what's required to obtain them (a Meta WhatsApp Business Platform app with
# approved message templates). Leave blank to run without WhatsApp; nothing
# else breaks.
FOND_WHATSAPP_TOKEN=
FOND_WHATSAPP_PHONE_NUMBER_ID=
